{
  "$schema": "../schemas/tacx-workout.schema.json",
  "format": "tacx-workout",
  "version": 1,
  "name": "Base 02 - Endurance Blocks",
  "description": "Weeks 2-6. Three 7-minute endurance blocks, with a short stand-and-stretch break between them.",
  "author": "Frank",
  "steps": [
    { "name": "Warm up", "duration": "4:00", "ftp_pct": [40, 60], "cadence": [80, 90] },
    { "repeat": 3, "name": "Endurance", "steps": [
      { "name": "Steady", "duration": "7:00", "ftp_pct": 62, "cadence": [85, 95] },
      { "name": "Easy", "duration": "1:00", "ftp_pct": 45,
        "text": [ { "at": "0:05", "msg": "Stand up for 20 s, stretch your back and hips" } ] }
    ] },
    { "name": "Cool down", "duration": "2:00", "ftp_pct": [50, 40] }
  ]
}

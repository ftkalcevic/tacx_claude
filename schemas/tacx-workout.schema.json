{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tacx-workout.schema.json",
  "title": "Tacx structured workout",
  "description": "A structured workout for tacx_neo.py. See workout_format.md. Run `tacx_neo.py check <file>` for the checks a schema can't do (message times within their step, watt limits at your FTP).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "steps"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this schema, for editor IntelliSense. Ignored by the program."
    },
    "format": { "const": "tacx-workout", "description": "Always \"tacx-workout\"." },
    "version": { "const": 1, "description": "Format version, currently 1." },
    "name": { "type": "string", "minLength": 1, "description": "Shown on the dashboard and in the launcher." },
    "description": { "type": "string", "description": "Free text, shown in the launcher." },
    "author": { "type": "string" },
    "steps": { "$ref": "#/definitions/items" }
  },
  "definitions": {
    "duration": {
      "description": "Seconds, or \"M:SS\" / \"H:MM:SS\".",
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "string", "pattern": "^\\s*\\d+(\\.\\d+)?(:\\d+(\\.\\d+)?){0,2}\\s*$" }
      ]
    },
    "offset": {
      "description": "Time from the start of the step: seconds, or \"M:SS\". Must not be past the end of the step.",
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^\\s*\\d+(\\.\\d+)?(:\\d+(\\.\\d+)?){0,2}\\s*$" }
      ]
    },
    "rpm": { "type": "number", "minimum": 20, "maximum": 200 },
    "cadence": {
      "description": "Cadence target, rpm: a number (±5 rpm) or [low, high]. Shown on the dashboard; doesn't control the trainer.",
      "oneOf": [
        { "$ref": "#/definitions/rpm" },
        { "type": "array", "items": { "$ref": "#/definitions/rpm" }, "minItems": 2, "maxItems": 2 }
      ]
    },
    "pct": { "type": "number", "minimum": 0, "maximum": 300 },
    "w": { "type": "number", "minimum": 0, "maximum": 2000 },
    "ftp_pct": {
      "description": "ERG power as a % of the rider's FTP. [start, end] is a ramp.",
      "oneOf": [
        { "$ref": "#/definitions/pct" },
        { "type": "array", "items": { "$ref": "#/definitions/pct" }, "minItems": 2, "maxItems": 2 }
      ]
    },
    "watts": {
      "description": "ERG power in absolute watts, the same for every rider. [start, end] is a ramp.",
      "oneOf": [
        { "$ref": "#/definitions/w" },
        { "type": "array", "items": { "$ref": "#/definitions/w" }, "minItems": 2, "maxItems": 2 }
      ]
    },
    "text": {
      "description": "On-screen messages during the step.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "msg"],
        "properties": {
          "at": { "$ref": "#/definitions/offset" },
          "msg": { "type": "string", "description": "The message." }
        },
        "defaultSnippets": [{ "label": "Message", "body": { "at": "${1:0:00}", "msg": "${2:Message}" } }]
      }
    },
    "step": {
      "description": "A step: a duration and exactly one target (ftp_pct, watts, grade, resistance or free).",
      "type": "object",
      "additionalProperties": false,
      "required": ["duration"],
      "properties": {
        "name": { "type": "string", "description": "Label shown on the dashboard, e.g. \"On\" or \"Recovery\"." },
        "duration": { "$ref": "#/definitions/duration" },
        "ftp_pct": { "$ref": "#/definitions/ftp_pct" },
        "watts": { "$ref": "#/definitions/watts" },
        "grade": {
          "type": "number", "minimum": -10, "maximum": 20,
          "description": "Slope mode gradient in %. The trainer adjusts resistance to your speed, like a real road."
        },
        "resistance": {
          "type": "number", "minimum": 0, "maximum": 100,
          "description": "Resistance mode, 0-100% of the trainer's brake."
        },
        "free": { "const": true, "description": "Free ride: a flat road with no target." },
        "cadence": { "$ref": "#/definitions/cadence" },
        "text": { "$ref": "#/definitions/text" }
      },
      "oneOf": [
        { "required": ["ftp_pct"] },
        { "required": ["watts"] },
        { "required": ["grade"] },
        { "required": ["resistance"] },
        { "required": ["free"] }
      ]
    },
    "repeat": {
      "description": "A block of steps run several times. Blocks can be nested.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repeat", "steps"],
      "properties": {
        "repeat": { "type": "integer", "minimum": 1, "description": "How many times to run the block." },
        "name": { "type": "string", "description": "Shown with a counter, e.g. \"VO2 2/5\"." },
        "steps": { "$ref": "#/definitions/items" }
      }
    },
    "item": {
      "if": { "type": "object", "required": ["repeat"] },
      "then": { "$ref": "#/definitions/repeat" },
      "else": { "$ref": "#/definitions/step" },
      "defaultSnippets": [
        { "label": "Step: % FTP", "body": { "name": "${1:Steady}", "duration": "${2:5:00}", "ftp_pct": "^${3:60}" } },
        { "label": "Step: ramp", "body": { "name": "${1:Warm up}", "duration": "${2:5:00}", "ftp_pct": ["^${3:40}", "^${4:60}"] } },
        { "label": "Step: % FTP with cadence", "body": { "name": "${1:Steady}", "duration": "${2:5:00}", "ftp_pct": "^${3:60}", "cadence": ["^${4:85}", "^${5:95}"] } },
        { "label": "Step: watts", "body": { "name": "${1:Steady}", "duration": "${2:5:00}", "watts": "^${3:120}" } },
        { "label": "Step: slope", "body": { "name": "${1:Climb}", "duration": "${2:3:00}", "grade": "^${3:2.0}" } },
        { "label": "Step: resistance", "body": { "name": "${1:Resistance}", "duration": "${2:3:00}", "resistance": "^${3:20}" } },
        { "label": "Step: free ride", "body": { "name": "${1:Free ride}", "duration": "${2:2:00}", "free": true } },
        {
          "label": "Repeat block (on/off)",
          "body": {
            "repeat": "^${1:3}", "name": "${2:Intervals}",
            "steps": [
              { "name": "On", "duration": "${3:1:00}", "ftp_pct": "^${4:100}" },
              { "name": "Off", "duration": "${5:1:00}", "ftp_pct": "^${6:50}" }
            ]
          }
        }
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "defaultSnippets": [
    {
      "label": "New workout",
      "body": {
        "$schema": "${1:../schemas/tacx-workout.schema.json}",
        "format": "tacx-workout",
        "version": 1,
        "name": "${2:New workout}",
        "description": "${3}",
        "steps": [
          { "name": "Warm up", "duration": "5:00", "ftp_pct": ["^40", "^60"] },
          { "name": "Steady", "duration": "20:00", "ftp_pct": "^60" },
          { "name": "Cool down", "duration": "5:00", "ftp_pct": ["^55", "^40"] }
        ]
      }
    }
  ]
}
